{
  "name": "orokia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "cd packages/backend && npx prisma generate",
    "dev": "pnpm --filter @orokia/shared build && pnpm --parallel --filter @orokia/shared --filter @orokia/backend --filter @orokia/web dev",
    "build": "pnpm -r --filter @orokia/shared --filter @orokia/backend --filter @orokia/web build",
    "build:api": "node scripts/build-api.mjs",
    "test": "pnpm -r --filter @orokia/backend --filter @orokia/shared test",
    "test:integration": "pnpm --filter @orokia/backend test:integration",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @orokia/backend prisma:migrate",
    "db:seed": "pnpm --filter @orokia/backend prisma:seed",
    "db:reset": "pnpm --filter @orokia/backend prisma:reset"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^5.22.0"
  }
}
