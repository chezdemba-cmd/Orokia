# Copy to packages/backend/.env and packages/web/.env as needed — see README.

# --- packages/backend/.env ---
DATABASE_URL="postgresql://orokia:orokia_dev_password@localhost:5432/orokia?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
OTP_HASH_SECRET="dev-otp-secret-change-me"

# Production (Vercel + Supabase) uniquement — voir DEPLOYMENT.md.
# DIRECT_URL : connexion directe Supabase (port 5432), utilisée par Prisma Migrate uniquement.
# DATABASE_URL en production doit alors pointer vers la connexion "pooled" (port 6543, pgbouncer=true).
# DIRECT_URL="postgresql://postgres:[password]@db.[projet].supabase.co:5432/postgres"
# CRON_SECRET="valeur-aleatoire-longue" — protège l'endpoint appelé par Vercel Cron.

# --- packages/web/.env ---
VITE_API_URL="http://localhost:4000"
